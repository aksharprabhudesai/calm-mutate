{
  "name": "calm-mutate",
  "version": "0.1.0",
  "description": "Adversarial conformance & mutation testing for FINOS CALM Patterns and Standards",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "calm-mutate": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "finos",
    "calm",
    "architecture-as-code",
    "mutation-testing",
    "json-schema",
    "conformance",
    "security"
  ],
  "dependencies": {
    "@finos/calm-cli": "^1.72.0",
    "@finos/calm-schema": "^1.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
